# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
# Check your provider's docs for the current base URL and model names.

# --- Option A: Google Gemini (free tier, OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-2.5-flash

# --- Option B: Groq (free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option C: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Price per 1M tokens in USD, for the cost log (0 for free tier).
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# Throttle to stay under free-tier rate limits (requests per minute, 0 = off).
LLM_MAX_RPM=10

# Embeddings: "st" = sentence-transformers (pip install -e ".[st]"), "hash" = offline fallback.
EMBED_BACKEND=st
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval. Leave THRESHOLD empty to use the backend default; tune it with `matcher tune`.
TOP_K=3
THRESHOLD=
